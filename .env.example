# Copy to .env and fill in. Never commit .env.
# docker-compose.yml overrides the hosts/roles below via each service's
# `environment:` block (postgres -> @postgres:5432). These values are for host
# tooling (uv run uvicorn, alembic, pytest) talking to a local Postgres.

# ---- Database ----
# App + tests connect as the NON-superuser role so Postgres row-level security
# actually applies. Alembic (DDL + CREATE ROLE) connects as the superuser.
DATABASE_URL=postgresql+asyncpg://tuklas_app:tuklas_app@localhost:5432/tuklas
MIGRATION_DATABASE_URL=postgresql+asyncpg://tuklas:tuklas@localhost:5432/tuklas
TEST_DATABASE_URL=postgresql+asyncpg://tuklas_app:tuklas_app@localhost:5432/tuklas_test

# ---- Queue ----
REDIS_URL=redis://localhost:6379/0

# ---- Auth ----
JWT_SECRET=dev-secret-change-me-not-for-production-use
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# 12 ~= 250ms/hash. Tests/CI set 4.
BCRYPT_ROUNDS=12

# ---- App ----
ENVIRONMENT=development
# Router mount prefix, e.g. /api/v1. Empty for now (frontend hits paths literally).
API_PREFIX=
# Comma-separated origins for CORS (NOT a JSON list).
CORS_ORIGINS=http://localhost:3000

# ---- LLM (Phase 1: local Ollama) ----
OLLAMA_HOST=http://localhost:11434
# ANTHROPIC_API_KEY=            # Phase 2 only

# ---- Crawler ----
CRAWLER_USER_AGENT=TuklasBot/0.1 (+https://example.com/bot)

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:8000
